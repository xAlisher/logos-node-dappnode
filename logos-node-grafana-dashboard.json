{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "tags": [
    "logos",
    "blockchain",
    "node"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "title": "Logos Blockchain Node",
  "uid": "logos-node",
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Node up / online",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "logos_node_online",
          "legendFormat": "online",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Mining",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OFF",
                  "color": "red"
                },
                "1": {
                  "text": "ON",
                  "color": "green"
                }
              }
            }
          ]
        }
      },
      "targets": [
        {
          "expr": "logos_node_mining",
          "legendFormat": "mining",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Connected peers",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "logos_node_connected_peers",
          "legendFormat": "peers",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Aged notes (stake)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
